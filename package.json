{
  "name": "taskharbor",
  "version": "1.14.1",
  "description": "小湾清单 (Cove) - 桌面端任务管理软件，让任务安全停靠、高效启航",
  "main": "main/dist/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "cd renderer && npm run dev",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build:main": "npx tsc -p main/tsconfig.json",
    "build:preload": "npx tsc -p preload/tsconfig.json",
    "build:renderer": "cd renderer && npm run build",
    "build:all": "npm run build:main && npm run build:preload && npm run build:renderer",
    "preview": "npx vite preview",
    "electron:build": "npm run build:renderer && npm run build:main && npm run build:preload && npx electron-builder",
    "electron:pack": "npx electron-builder --dir",
    "build:win": "npm run build:all && npx electron-builder --win --x64",
    "build:win:portable": "npm run build:all && npx electron-builder --win portable --x64",
    "build:win:nsis": "npm run build:all && npx electron-builder --win nsis --x64",
    "pack:win": "powershell -ExecutionPolicy Bypass -File ./scripts/build-windows.ps1",
    "typecheck": "npx tsc --noEmit --project main/tsconfig.json && npx tsc --noEmit --project preload/tsconfig.json",
    "typecheck:all": "npm run typecheck && cd renderer && npx tsc -b --noEmit",
    "test": "node tests/run-tests.js",
    "lint": "cd renderer && npm run lint",
    "lint:fix": "cd renderer && npm run lint -- --fix",
    "format": "cd renderer && npx prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "cd renderer && npx prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "ci": "npm run typecheck:all && npm run lint && npm run test",
    "mobile:build": "cd renderer && npm run build:mobile",
    "cap:sync": "npm run mobile:build && npx cap sync android",
    "cap:open": "npx cap open android",
    "apk:debug": "cd android && .\\gradlew.bat assembleDebug",
    "apk:release": "cd android && .\\gradlew.bat assembleRelease"
  },
  "author": "AZE-BlackCore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitcode.com/AZE-BlackCore/Cove.git"
  },
  "homepage": "https://gitcode.com/AZE-BlackCore/Cove",
  "bugs": {
    "url": "https://gitcode.com/AZE-BlackCore/Cove/issues"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "@types/sql.js": "^1.4.11",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.1.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^5.0.11",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.4",
    "electron-store": "^8.1.0",
    "electron-window-state": "^5.0.3",
    "exceljs": "^4.4.0",
    "marked": "^11.1.1",
    "pdfkit": "^0.14.0",
    "sql.js": "^1.10.3"
  },
  "build": {
    "appId": "com.taskharbor.desktop",
    "productName": "小湾清单",
    "directories": {
      "output": "builds/dist-output"
    },
    "files": [
      "main/dist/**/*",
      "node_modules/sql.js/dist/**/*",
      "core/schema/**/*"
    ],
    "extraResources": [
      {
        "from": "preload/dist",
        "to": "preload/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "renderer/dist",
        "to": "renderer/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "renderer/public",
        "to": "renderer/public",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "tools/mcp-server",
        "to": "mcp-server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/**/*",
      "**/*.node"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "renderer/public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "renderer/public/icon.ico",
      "uninstallerIcon": "renderer/public/icon.ico",
      "installerHeaderIcon": "renderer/public/icon.ico"
    }
  }
}
